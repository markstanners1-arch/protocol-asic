set_io -nowarn o_led[0]   56
set_io -nowarn o_led[1]   57
set_io -nowarn o_led[2]   59
set_io -nowarn o_led[3]   60
set_io -nowarn o_seg1[0]  3
set_io -nowarn o_seg1[1]  4
set_io -nowarn o_seg1[2]  93
set_io -nowarn o_seg1[3]  91
set_io -nowarn o_seg1[4]  90
set_io -nowarn o_seg1[5]  1
set_io -nowarn o_seg1[6]  2
set_io -nowarn o_seg2[0]  100
set_io -nowarn o_seg2[1]  99
set_io -nowarn o_seg2[2]  97
set_io -nowarn o_seg2[3]  95
set_io -nowarn o_seg2[4]  94
set_io -nowarn o_seg2[5]  8
set_io -nowarn o_seg2[6]  96
