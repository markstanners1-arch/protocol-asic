# Nandland Go Board: iCE40 HX1K, VQ100 package, 25 MHz oscillator.
# Pins agreed by two independent sources (olofk/serv data/go_board.pcf and
# jeffadickson/SharpHDL boards/GoBoard/classroom.pcf); Nandland's own file is no longer online.
set_io -nowarn i_clk      15
set_io -nowarn o_led[0]   56
set_io -nowarn o_led[1]   57
set_io -nowarn o_led[2]   59
set_io -nowarn o_led[3]   60
set_io -nowarn i_sw[0]    53
set_io -nowarn i_sw[1]    51
set_io -nowarn i_sw[2]    54
set_io -nowarn i_sw[3]    52
set_io -nowarn o_uart_tx  74
# PMOD connector (2 x 6). Pins 5 and 11 = GND, 6 and 12 = 3.3 V.
# Agreed by FPGAwars/icestudio boards/go-board/pinout.pcf and ucf-draco-mike/hdl-for-dsd-student shared/pcf/go_board.pcf
set_io -nowarn io_pmod[0]  65
set_io -nowarn io_pmod[1]  64
set_io -nowarn io_pmod[2]  63
set_io -nowarn io_pmod[3]  62
set_io -nowarn io_pmod[4]  78
set_io -nowarn io_pmod[5]  79
set_io -nowarn io_pmod[6]  80
set_io -nowarn io_pmod[7]  81
set_io -nowarn i_uart_rx   73
