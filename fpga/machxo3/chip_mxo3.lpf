# Whole chip on the MachXO3L Starter Kit, header J4 (see chip_mxo3.v for the hole numbers).
# Ball names from the kit user guide (FPGA-EB-02036 Table 5, J4) and the clock/LED pins agreed by two projects.
LOCATE COMP "clk" SITE "C8";
IOBUF PORT "clk" IO_TYPE=LVCMOS33;
LOCATE COMP "cs_n" SITE "K12";
IOBUF PORT "cs_n" IO_TYPE=LVCMOS33 PULLMODE=UP;
LOCATE COMP "mosi" SITE "M14";
IOBUF PORT "mosi" IO_TYPE=LVCMOS33 PULLMODE=DOWN;
LOCATE COMP "miso" SITE "L14";
IOBUF PORT "miso" IO_TYPE=LVCMOS33;
LOCATE COMP "sck" SITE "M15";
IOBUF PORT "sck" IO_TYPE=LVCMOS33 PULLMODE=DOWN;
LOCATE COMP "irq" SITE "K13";
IOBUF PORT "irq" IO_TYPE=LVCMOS33;
LOCATE COMP "uio[0]" SITE "N14";
IOBUF PORT "uio[0]" IO_TYPE=LVCMOS33 PULLMODE=UP;
LOCATE COMP "uio[1]" SITE "N16";
IOBUF PORT "uio[1]" IO_TYPE=LVCMOS33 PULLMODE=UP;
LOCATE COMP "uio[2]" SITE "M16";
IOBUF PORT "uio[2]" IO_TYPE=LVCMOS33 PULLMODE=UP;
LOCATE COMP "uio[3]" SITE "L15";
IOBUF PORT "uio[3]" IO_TYPE=LVCMOS33 PULLMODE=UP;
LOCATE COMP "uio[4]" SITE "L16";
IOBUF PORT "uio[4]" IO_TYPE=LVCMOS33 PULLMODE=UP;
LOCATE COMP "uio[5]" SITE "K14";
IOBUF PORT "uio[5]" IO_TYPE=LVCMOS33 PULLMODE=UP;
LOCATE COMP "uio[6]" SITE "K16";
IOBUF PORT "uio[6]" IO_TYPE=LVCMOS33 PULLMODE=UP;
LOCATE COMP "uio[7]" SITE "K15";
IOBUF PORT "uio[7]" IO_TYPE=LVCMOS33 PULLMODE=UP;
LOCATE COMP "uo_hi[0]" SITE "J14";
IOBUF PORT "uo_hi[0]" IO_TYPE=LVCMOS33;
LOCATE COMP "uo_hi[1]" SITE "H14";
IOBUF PORT "uo_hi[1]" IO_TYPE=LVCMOS33;
LOCATE COMP "uo_hi[2]" SITE "J15";
IOBUF PORT "uo_hi[2]" IO_TYPE=LVCMOS33;
LOCATE COMP "uo_hi[3]" SITE "J16";
IOBUF PORT "uo_hi[3]" IO_TYPE=LVCMOS33;
LOCATE COMP "uo_hi[4]" SITE "H15";
IOBUF PORT "uo_hi[4]" IO_TYPE=LVCMOS33;
LOCATE COMP "uo_hi[5]" SITE "H16";
IOBUF PORT "uo_hi[5]" IO_TYPE=LVCMOS33;
LOCATE COMP "ui_hi[0]" SITE "G15";
IOBUF PORT "ui_hi[0]" IO_TYPE=LVCMOS33 PULLMODE=DOWN;
LOCATE COMP "ui_hi[1]" SITE "G16";
IOBUF PORT "ui_hi[1]" IO_TYPE=LVCMOS33 PULLMODE=DOWN;
LOCATE COMP "ui_hi[2]" SITE "F15";
IOBUF PORT "ui_hi[2]" IO_TYPE=LVCMOS33 PULLMODE=DOWN;
LOCATE COMP "ui_hi[3]" SITE "F16";
IOBUF PORT "ui_hi[3]" IO_TYPE=LVCMOS33 PULLMODE=DOWN;
LOCATE COMP "ui_hi[4]" SITE "E15";
IOBUF PORT "ui_hi[4]" IO_TYPE=LVCMOS33 PULLMODE=DOWN;
LOCATE COMP "led[0]" SITE "P16";
IOBUF PORT "led[0]" IO_TYPE=LVCMOS33;
LOCATE COMP "led[1]" SITE "N15";
IOBUF PORT "led[1]" IO_TYPE=LVCMOS33;
FREQUENCY PORT "clk" 12 MHZ;
