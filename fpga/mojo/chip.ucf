# Whole chip on the Mojo v3 (XC6SLX9-2TQG144) with the IO Shield stacked on top. See chip_mojo.v.
# Clock, reset button and LED pins from Embedded Micro's mojo-base-project src/mojo.ucf; the shield's pins from
# components-library components/io_shield.ucf.
#
# Pin choice. Both side headers together carry the Mojo's 84 user I/O, two FPGA pins to a row (the shield prints one
# number per row: "50" is the row holding P50 and P51; on the left header "58" is the row holding P57 and P58).
# The shield's own devices use 65 of them (24 LEDs, 24 DIP switches, 5 buttons, 8 segments, 4 digit selects).
# What is left:
#   11 pins with nothing on them: P50 P51 P40 P41 P34 P35 P32 P33 P29 P30 (right header rows 50-29) and P27 (row 26)
#    8 pins carrying the Mojo's own LEDs (each LED with its resistor to ground): P134 P133 P132 P131 P127 P126 P124 P123
# That is 19; the chip needs 25. So:
#   - the 11 free pins take the three host inputs (CS, SCK, MOSI, together at the top) and engine pins 0-7, the
#     two-way pins with pull-ups, where an LED to ground would hold an undriven line (and an I2C bus) near 1.8 V;
#   - the 8 LED pins take the chip's eight push-pull outputs that are always driven: MISO, IRQ and engine pins 8-13
#     (an LED load is harmless on a driven output, and each LED then shows its pin);
#   - engine pins 15-19 (inputs only, pull-downs as on the kit) go on shield DIP switch pins dip<23:19>, rows 58, 67
#     and 75 of the left header: with the switch OFF the pin is free for a lead; with it ON the switch holds it high.
#     Every shield DIP switch stays OFF while a lead is in one of these holes.
# Not used: the shield's LEDs, display and buttons (driven by the wrapper or left alone), the AVR link (P39 P43-P48
# P55 P59 P61 P62 P65 P70: left undriven, bitgen UnusedPin:PullNone).

NET "clk" LOC = P56 | IOSTANDARD = LVTTL;
NET "clk" TNM_NET = clk;
TIMESPEC TS_clk = PERIOD "clk" 50 MHz HIGH 50%;
NET "rst_n" LOC = P38 | IOSTANDARD = LVTTL | PULLUP;

# host port (pull-up on CS, pull-downs on SCK and MOSI, as on the MachXO3L kit)
NET "cs_n" LOC = P50 | IOSTANDARD = LVTTL | PULLUP;
NET "sck"  LOC = P51 | IOSTANDARD = LVTTL | PULLDOWN;
NET "mosi" LOC = P40 | IOSTANDARD = LVTTL | PULLDOWN;
NET "miso" LOC = P134 | IOSTANDARD = LVTTL;            # Mojo LED0
NET "irq"  LOC = P133 | IOSTANDARD = LVTTL;            # Mojo LED1

# engine pins 0-7, two-way, pull-ups
NET "uio<0>" LOC = P41 | IOSTANDARD = LVTTL | PULLUP;
NET "uio<1>" LOC = P34 | IOSTANDARD = LVTTL | PULLUP;
NET "uio<2>" LOC = P35 | IOSTANDARD = LVTTL | PULLUP;
NET "uio<3>" LOC = P32 | IOSTANDARD = LVTTL | PULLUP;
NET "uio<4>" LOC = P33 | IOSTANDARD = LVTTL | PULLUP;
NET "uio<5>" LOC = P29 | IOSTANDARD = LVTTL | PULLUP;
NET "uio<6>" LOC = P30 | IOSTANDARD = LVTTL | PULLUP;
NET "uio<7>" LOC = P27 | IOSTANDARD = LVTTL | PULLUP;

# engine pins 8-13, outputs, on the Mojo LED2-LED7 pins
NET "uo_hi<0>" LOC = P132 | IOSTANDARD = LVTTL;        # engine pin 8,  LED2
NET "uo_hi<1>" LOC = P131 | IOSTANDARD = LVTTL;        # engine pin 9,  LED3
NET "uo_hi<2>" LOC = P127 | IOSTANDARD = LVTTL;        # engine pin 10, LED4
NET "uo_hi<3>" LOC = P126 | IOSTANDARD = LVTTL;        # engine pin 11, LED5
NET "uo_hi<4>" LOC = P124 | IOSTANDARD = LVTTL;        # engine pin 12, LED6
NET "uo_hi<5>" LOC = P123 | IOSTANDARD = LVTTL;        # engine pin 13, LED7

# engine pins 15-19, inputs, pull-downs, on shield DIP switch pins dip<23:19>
NET "ui_hi<0>" LOC = P57 | IOSTANDARD = LVTTL | PULLDOWN;   # engine pin 15
NET "ui_hi<1>" LOC = P58 | IOSTANDARD = LVTTL | PULLDOWN;   # engine pin 16
NET "ui_hi<2>" LOC = P66 | IOSTANDARD = LVTTL | PULLDOWN;   # engine pin 17
NET "ui_hi<3>" LOC = P67 | IOSTANDARD = LVTTL | PULLDOWN;   # engine pin 18
NET "ui_hi<4>" LOC = P74 | IOSTANDARD = LVTTL | PULLDOWN;   # engine pin 19

# IO Shield LEDs, 7-segment display (status only, see chip_mojo.v)
NET "io_led<0>"  LOC = P97 | IOSTANDARD = LVTTL;
NET "io_led<1>"  LOC = P98 | IOSTANDARD = LVTTL;
NET "io_led<2>"  LOC = P94 | IOSTANDARD = LVTTL;
NET "io_led<3>"  LOC = P95 | IOSTANDARD = LVTTL;
NET "io_led<4>"  LOC = P92 | IOSTANDARD = LVTTL;
NET "io_led<5>"  LOC = P93 | IOSTANDARD = LVTTL;
NET "io_led<6>"  LOC = P87 | IOSTANDARD = LVTTL;
NET "io_led<7>"  LOC = P88 | IOSTANDARD = LVTTL;
NET "io_led<8>"  LOC = P84 | IOSTANDARD = LVTTL;
NET "io_led<9>"  LOC = P85 | IOSTANDARD = LVTTL;
NET "io_led<10>" LOC = P82 | IOSTANDARD = LVTTL;
NET "io_led<11>" LOC = P83 | IOSTANDARD = LVTTL;
NET "io_led<12>" LOC = P80 | IOSTANDARD = LVTTL;
NET "io_led<13>" LOC = P81 | IOSTANDARD = LVTTL;
NET "io_led<14>" LOC = P11 | IOSTANDARD = LVTTL;
NET "io_led<15>" LOC = P14 | IOSTANDARD = LVTTL;
NET "io_led<16>" LOC = P15 | IOSTANDARD = LVTTL;
NET "io_led<17>" LOC = P16 | IOSTANDARD = LVTTL;
NET "io_led<18>" LOC = P17 | IOSTANDARD = LVTTL;
NET "io_led<19>" LOC = P21 | IOSTANDARD = LVTTL;
NET "io_led<20>" LOC = P22 | IOSTANDARD = LVTTL;
NET "io_led<21>" LOC = P23 | IOSTANDARD = LVTTL;
NET "io_led<22>" LOC = P24 | IOSTANDARD = LVTTL;
NET "io_led<23>" LOC = P26 | IOSTANDARD = LVTTL;
NET "io_seg<0>" LOC = P5   | IOSTANDARD = LVTTL;
NET "io_seg<1>" LOC = P8   | IOSTANDARD = LVTTL;
NET "io_seg<2>" LOC = P144 | IOSTANDARD = LVTTL;
NET "io_seg<3>" LOC = P143 | IOSTANDARD = LVTTL;
NET "io_seg<4>" LOC = P2   | IOSTANDARD = LVTTL;
NET "io_seg<5>" LOC = P6   | IOSTANDARD = LVTTL;
NET "io_seg<6>" LOC = P1   | IOSTANDARD = LVTTL;
NET "io_seg<7>" LOC = P141 | IOSTANDARD = LVTTL;
NET "io_sel<0>" LOC = P9   | IOSTANDARD = LVTTL;
NET "io_sel<1>" LOC = P10  | IOSTANDARD = LVTTL;
NET "io_sel<2>" LOC = P7   | IOSTANDARD = LVTTL;
NET "io_sel<3>" LOC = P12  | IOSTANDARD = LVTTL;
