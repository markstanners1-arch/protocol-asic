# Pin finder (pin_finder.v): the chip build's lead pins as inputs with pull-ups; display and LEDs as in chip.ucf.
NET "clk" LOC = P56 | IOSTANDARD = LVTTL;
NET "clk" TNM_NET = clk;
TIMESPEC TS_clk = PERIOD "clk" 50 MHz HIGH 50%;
NET "probe<0>" LOC = P50 | IOSTANDARD = LVTTL | PULLUP;
NET "probe<1>" LOC = P51 | IOSTANDARD = LVTTL | PULLUP;
