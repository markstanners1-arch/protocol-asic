# Quartus settings for the whole chip on a Cyclone IV E EP4CE6 board.
# DEVICE: change to the exact part on the board (EP4CE6E22C8 is the usual one on the small boards).
set_global_assignment -name FAMILY "Cyclone IV E"
set_global_assignment -name DEVICE EP4CE6E22C8
set_global_assignment -name TOP_LEVEL_ENTITY chip_c4
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY build
set_global_assignment -name VERILOG_FILE ../../src/chip.v
set_global_assignment -name VERILOG_FILE ../../src/cluster.v
set_global_assignment -name VERILOG_FILE ../../src/host_spi.v
set_global_assignment -name VERILOG_FILE ../../src/engine.v
set_global_assignment -name VERILOG_FILE ../../src/serialiser.v
set_global_assignment -name VERILOG_FILE ../../src/receiver.v
set_global_assignment -name VERILOG_FILE ../../src/crc32.v
set_global_assignment -name VERILOG_FILE ../../src/prog_mem.v
set_global_assignment -name VERILOG_FILE ../../src/fifo_mem.v
set_global_assignment -name VERILOG_FILE ../../src/glitch_filter.v
set_global_assignment -name VERILOG_FILE chip_c4.v
set_global_assignment -name SDC_FILE chip_c4.sdc
set_global_assignment -name STRATIX_DEVICE_IO_STANDARD "3.3-V LVTTL"
set_global_assignment -name RESERVE_ALL_UNUSED_PINS_WEAK_PULLUP "AS INPUT TRI-STATED WITH WEAK PULL-UP"
set_global_assignment -name CYCLONEII_RESERVE_NCEO_AFTER_CONFIGURATION "USE AS REGULAR IO"
set_global_assignment -name ENABLE_CONFIGURATION_PINS OFF
set_global_assignment -name ENABLE_BOOT_SEL_PIN OFF
set_global_assignment -name RESERVE_DATA0_AFTER_CONFIGURATION "USE AS REGULAR IO"
set_global_assignment -name RESERVE_DATA1_AFTER_CONFIGURATION "USE AS REGULAR IO"
set_global_assignment -name RESERVE_FLASH_NCE_AFTER_CONFIGURATION "USE AS REGULAR IO"
set_global_assignment -name RESERVE_DCLK_AFTER_CONFIGURATION "USE AS REGULAR IO"

# Pin locations (3 Nov 2026, read off the board's silkscreen: black EP4CE6E22C8N core board, USB-C power + CH340 serial,
# 10-pin JTAG, 50 MHz oscillator "50M 24/25", serial RX 23 / TX 10, five LEDs on 1 2 3 7 11, both bank jumpers at 3.3 V).
# Everything for the bench sits on the right-hand header, pins 38-72, one 3.3 V bank (VB), in silkscreen order.
set_location_assignment PIN_24 -to clk            # 50 MHz
set_location_assignment PIN_38 -to cs_n
set_location_assignment PIN_39 -to sck
set_location_assignment PIN_42 -to mosi
set_location_assignment PIN_43 -to miso
set_location_assignment PIN_44 -to irq
set_location_assignment PIN_46 -to uio[0]         # engine pins 0-7
set_location_assignment PIN_49 -to uio[1]
set_location_assignment PIN_50 -to uio[2]
set_location_assignment PIN_51 -to uio[3]
set_location_assignment PIN_52 -to uio[4]
set_location_assignment PIN_53 -to uio[5]
set_location_assignment PIN_54 -to uio[6]
set_location_assignment PIN_55 -to uio[7]
set_location_assignment PIN_58 -to uo_hi[0]       # engine pins 8-13 (out only)
set_location_assignment PIN_59 -to uo_hi[1]
set_location_assignment PIN_60 -to uo_hi[2]
set_location_assignment PIN_64 -to uo_hi[3]
set_location_assignment PIN_65 -to uo_hi[4]
set_location_assignment PIN_66 -to uo_hi[5]
set_location_assignment PIN_67 -to ui_hi[0]       # engine pins 15-19 (in only)
set_location_assignment PIN_68 -to ui_hi[1]
set_location_assignment PIN_69 -to ui_hi[2]
set_location_assignment PIN_70 -to ui_hi[3]
set_location_assignment PIN_71 -to ui_hi[4]
set_location_assignment PIN_1 -to led[0]          # board LEDs: IRQ, heartbeat (about 0.7 s at 50 MHz)
set_location_assignment PIN_2 -to led[1]
set_instance_assignment -name WEAK_PULL_UP_RESISTOR ON -to cs_n
set_instance_assignment -name WEAK_PULL_UP_RESISTOR ON -to uio[*]

set_global_assignment -name LAST_QUARTUS_VERSION "25.1std.0 Lite Edition"
# Area first (3 Nov 2026): three engines need 6,273 cells of 6,272 with the default settings, 6,116 with these
set_global_assignment -name OPTIMIZATION_TECHNIQUE AREA

set_global_assignment -name CYCLONEII_OPTIMIZATION_TECHNIQUE AREA
set_global_assignment -name AUTO_PACKED_REGISTERS_STRATIX "MINIMIZE AREA"
