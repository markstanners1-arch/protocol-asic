# chip_i9.v on the Colorlight i9 v7.2 + Muse Lab breakout. Sites are FPGA balls, as printed beside each header on
# Muse Lab's pin map. All LVCMOS33 (3.3 V). Header pins numbered as in docs/bench_wiring.md section 15.
#   P2: CS pin 15 (G20), SCK 14 (K20), MOSI 13 (L20), MISO 12 (N18), IRQ 16 (J20), reset 3 (K18, pulled up), GND 11
#   P3: engine pins 0-7 = pins 15, 14, 13, 12, 16, 17, 18, 19 (E2 D2 B1 A3 D1 C1 C2 E3)
#       engine pins 15-19 = pins 9, 7, 22, 24, 6 (C3 C4 B4 D3 A18)
#       engine pins 8-13 = pins 5, 4, 3, 25, 26, 27 (A19 B19 D20 C17 B18 B20)
# The module LED (L2) is also on header P2 pin 28: leave that pin unwired.

LOCATE COMP "clk25" SITE "P3";
IOBUF PORT "clk25" IO_TYPE=LVCMOS33;
LOCATE COMP "led" SITE "L2";
IOBUF PORT "led" IO_TYPE=LVCMOS33;
LOCATE COMP "cs_n" SITE "G20";
IOBUF PORT "cs_n" IO_TYPE=LVCMOS33 PULLMODE=UP;
LOCATE COMP "sck" SITE "K20";
IOBUF PORT "sck" IO_TYPE=LVCMOS33;
LOCATE COMP "mosi" SITE "L20";
IOBUF PORT "mosi" IO_TYPE=LVCMOS33;
LOCATE COMP "miso" SITE "N18";
IOBUF PORT "miso" IO_TYPE=LVCMOS33;
LOCATE COMP "irq" SITE "J20";
IOBUF PORT "irq" IO_TYPE=LVCMOS33;
LOCATE COMP "rst_n_pin" SITE "K18";
IOBUF PORT "rst_n_pin" IO_TYPE=LVCMOS33 PULLMODE=UP;
LOCATE COMP "uio[0]" SITE "E2";
IOBUF PORT "uio[0]" IO_TYPE=LVCMOS33 PULLMODE=UP;
LOCATE COMP "uio[1]" SITE "D2";
IOBUF PORT "uio[1]" IO_TYPE=LVCMOS33 PULLMODE=UP;
LOCATE COMP "uio[2]" SITE "B1";
IOBUF PORT "uio[2]" IO_TYPE=LVCMOS33 PULLMODE=UP;
LOCATE COMP "uio[3]" SITE "A3";
IOBUF PORT "uio[3]" IO_TYPE=LVCMOS33 PULLMODE=UP;
LOCATE COMP "uio[4]" SITE "D1";
IOBUF PORT "uio[4]" IO_TYPE=LVCMOS33 PULLMODE=UP;
LOCATE COMP "uio[5]" SITE "C1";
IOBUF PORT "uio[5]" IO_TYPE=LVCMOS33 PULLMODE=UP;
LOCATE COMP "uio[6]" SITE "C2";
IOBUF PORT "uio[6]" IO_TYPE=LVCMOS33 PULLMODE=UP;
LOCATE COMP "uio[7]" SITE "E3";
IOBUF PORT "uio[7]" IO_TYPE=LVCMOS33 PULLMODE=UP;
LOCATE COMP "ui_hi[0]" SITE "C3";
IOBUF PORT "ui_hi[0]" IO_TYPE=LVCMOS33 PULLMODE=UP;
LOCATE COMP "ui_hi[1]" SITE "C4";
IOBUF PORT "ui_hi[1]" IO_TYPE=LVCMOS33 PULLMODE=UP;
LOCATE COMP "ui_hi[2]" SITE "B4";
IOBUF PORT "ui_hi[2]" IO_TYPE=LVCMOS33 PULLMODE=UP;
LOCATE COMP "ui_hi[3]" SITE "D3";
IOBUF PORT "ui_hi[3]" IO_TYPE=LVCMOS33 PULLMODE=UP;
LOCATE COMP "ui_hi[4]" SITE "A18";
IOBUF PORT "ui_hi[4]" IO_TYPE=LVCMOS33 PULLMODE=UP;
LOCATE COMP "uo[0]" SITE "A19";
IOBUF PORT "uo[0]" IO_TYPE=LVCMOS33;
LOCATE COMP "uo[1]" SITE "B19";
IOBUF PORT "uo[1]" IO_TYPE=LVCMOS33;
LOCATE COMP "uo[2]" SITE "D20";
IOBUF PORT "uo[2]" IO_TYPE=LVCMOS33;
LOCATE COMP "uo[3]" SITE "C17";
IOBUF PORT "uo[3]" IO_TYPE=LVCMOS33;
LOCATE COMP "uo[4]" SITE "B18";
IOBUF PORT "uo[4]" IO_TYPE=LVCMOS33;
LOCATE COMP "uo[5]" SITE "B20";
IOBUF PORT "uo[5]" IO_TYPE=LVCMOS33;
FREQUENCY PORT "clk25" 25 MHZ;
